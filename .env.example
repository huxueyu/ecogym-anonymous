# =============================================================================
# API Configuration for Multiple Suppliers
# =============================================================================
# This project supports multiple model suppliers. Each model in 
# config/model_pricing.yaml specifies which supplier it uses.
# The system will automatically select the correct credentials based on the model.
# =============================================================================

# -----------------------------------------------------------------------------
# MTU Supplier Configuration (https://mtu.mtuopenai.xyz)
# -----------------------------------------------------------------------------
# Used for models like: gpt-5.x, gemini-3-x, deepseek-v3.2, etc.
MTU_API_KEY=sk-your-mtu-api-key-here
MTU_API_URL=https://mtu.mtuopenai.xyz/v1

# -----------------------------------------------------------------------------
# UNI Supplier Configuration (https://uniapi.ai)
# -----------------------------------------------------------------------------
# Used for models like: qwen3-x, claude-sonnet, glm-4.7, grok, etc.
UNI_API_KEY=sk-your-uni-api-key-here
UNI_API_URL=https://uniapi.ai/v1

# -----------------------------------------------------------------------------
# Legacy/Fallback Configuration (Optional)
# -----------------------------------------------------------------------------
# These are used as fallback if supplier-specific credentials are not found.
# You can keep these for backward compatibility or remove them if not needed.
API_KEY=sk-your-default-api-key-here
API_URL=https://mtu.mtuopenai.xyz/v1

# Legacy Perplexity Configuration (for specific tools if needed)
PERPLEXITY_API_KEY=sk-your-perplexity-api-key-here
PERPLEXITY_BASE_URL=https://api.mtuo.ai/v1/chat/completions

# =============================================================================
# Usage Instructions:
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values with your actual API keys
# 3. The system will automatically use the correct supplier based on the model
#    you select in your configuration file
#
# Note: Each model's supplier is defined in config/model_pricing.yaml
# =============================================================================
